"""
Help DMEs — Fut.gg Scraping Service
======================================
Serviço de coleta de SBCs do site fut.gg/sbc/.
Usa Playwright com stealth para contornar proteções anti-bot.

Fluxo de coleta:
  1. Acessa fut.gg/sbc/ → coleta lista de SBC sets (nome, custo, categoria, etc.)
  2. Para cada SBC set → acessa página de detalhes → coleta challenges, requisitos, rewards
  3. Persiste tudo no banco via SQLAlchemy async

Fallback: se Fut.gg falhar, o main.py chama futnext_service.py
"""

import asyncio
import logging
from datetime import datetime, UTC
from typing import Optional
import re
import random

from sqlalchemy import select, delete
from sqlalchemy.ext.asyncio import AsyncSession

from backend.models.models import (
    SBCSet, SBCChallenge, ChallengeRequirement,
    SBCReward, PlayerCard, ScrapeLog,
)
from backend.services.scraping_utils import parse_requirement_text, create_stealth_context, parse_cost_text
from sqlalchemy.ext.asyncio import AsyncSession

from backend.models.models import (
    SBCSet, SBCChallenge, ChallengeRequirement,
    SBCReward, PlayerCard, ScrapeLog,
)

logger = logging.getLogger("help_dmes." + __name__.split(".")[-1])


# ──────────────────────────────────────────────
# Estado global do scraper
# ──────────────────────────────────────────────

_scrape_status = {
    "status": "idle",       # idle / running / failed
    "message": "",          # Progresso
    "last_scrape_at": None,
    "sbcs_count": 0,
    "error": None,
}


def get_scrape_status() -> dict:
    """Retorna o status atual do scraper (sem acessar banco)."""
    return _scrape_status.copy()


# ──────────────────────────────────────────────
# Scraper principal
# ──────────────────────────────────────────────

async def scrape_all_sbcs(session: AsyncSession) -> dict:
    """
    Coleta TODOS os SBCs do fut.gg/sbc/.
    Atualiza o status global durante a execução.

    Retorna: {"status": str, "sbcs_scraped": int, "error": str | None}
    """
    global _scrape_status
    _scrape_status["status"] = "running"
    _scrape_status["message"] = "Iniciando scrape..."
    _scrape_status["error"] = None

    log = ScrapeLog(
        source="fut.gg",
        status="running",
        sbcs_scraped=0,
        started_at=datetime.now(UTC),
    )
    session.add(log)
    await session.flush()

    try:
        from playwright.async_api import async_playwright

        async with async_playwright() as p:
            browser, context, page = await create_stealth_context(p)

            # ── Passo 1: Coletar lista de SBCs ──
            _scrape_status["message"] = "Acessando página de SBCs..."
            await page.goto("https://www.fut.gg/sbc/", wait_until="load", timeout=30000)
            await page.wait_for_timeout(2000)

            sbc_data = await _extract_sbc_list(page)

            if not sbc_data:
                raise Exception("Nenhum SBC encontrado na página fut.gg/sbc/")

            # ── Passo 2: Para cada SBC, coletar detalhes ──
            scraped_count = 0
            total_sbcs = len(sbc_data)
            for sbc_info in sbc_data:
                _scrape_status["message"] = f"Processando SBC {scraped_count + 1}/{total_sbcs}: {sbc_info.get('name', 'Unknown')}"
                try:
                    await _process_sbc(session, page, sbc_info)
                    scraped_count += 1
                except Exception:
                    continue  # Pular SBCs com erro e continuar

            await browser.close()

        # Sucesso
        log.status = "success"
        log.sbcs_scraped = scraped_count
        log.finished_at = datetime.now(UTC)
        _scrape_status["status"] = "idle"
        _scrape_status["message"] = "Concluído"
        _scrape_status["last_scrape_at"] = datetime.now(UTC)
        _scrape_status["sbcs_count"] = scraped_count

        await session.flush()
        return {"status": "success", "sbcs_scraped": scraped_count, "error": None}

    except Exception as e:
        error_msg = str(e)
        print(f"CRITICAL SCRAPE ERROR (fut.gg): {error_msg}")
        log.status = "failed"
        log.error_message = error_msg
        log.finished_at = datetime.now(UTC)
        _scrape_status["status"] = "failed"
        _scrape_status["message"] = "Erro: " + error_msg
        _scrape_status["error"] = error_msg

        await session.flush()
        return {"status": "failed", "sbcs_scraped": 0, "error": error_msg}


async def _extract_sbc_list(page) -> list[dict]:
    """
    Extrai a lista de SBCs da página principal fut.gg/sbc/.
    Agora captura imagem, categoria e custo estimado diretamente da lista se disponível.
    """
    data = await page.evaluate("""
        () => {
            const results = [];
            const sbcCards = document.querySelectorAll('.grid > div.bg-gray-800'); // Seleciona os cards de SBC
            
            for (const card of sbcCards) {
                const link = card.querySelector('a[href*="/sbc/"]');
                if (!link) continue;
                
                const href = link.getAttribute('href');
                const name = card.querySelector('h3')?.textContent?.trim();
                const costEl = card.querySelector('.text-sm.font-bold, span.font-bold');
                const costText = costEl ? costEl.textContent.replace(/[^\\d]/g, '') : null;
                
                // Tentar capturar a imagem do card (pode ser jogador ou genérica de SBC)
                const img = card.querySelector('img[src*="/sbcs/"], img[src*="/player-item-card/"], .fc-card img');
                const imageUrl = img ? img.src.split('?')[0] : null;

                // Extrair ID do futgg da URL
                const match = href.match(/\\/sbc\\/.*?\\/([\\w-]+)/) || href.match(/\\/sbc\\/([\\w-]+)/);
                if (!match) continue;

                results.push({
                    futgg_id: match[match.length - 1],
                    name: name || match[match.length - 1],
                    url: href.startsWith('http') ? href : 'https://www.fut.gg' + href,
                    image_url: imageUrl,
                    total_cost: costText ? parseInt(costText) : null
                });
            }
            return results;
        }
    """)

    return data or []


async def _process_sbc(session: AsyncSession, page, sbc_info: dict):
    """
    Processa um SBC individual.
    """
    futgg_id = sbc_info["futgg_id"]
    url = sbc_info["url"]

    # Verificar se já existe no banco
    existing = await session.execute(
        select(SBCSet).where(SBCSet.futgg_id == futgg_id)
    )
    sbc_set = existing.scalar_one_or_none()

    if sbc_set:
        sbc_set.scraped_at = datetime.now(UTC)
        if sbc_info.get("image_url"): sbc_set.image_url = sbc_info["image_url"]
        if sbc_info.get("total_cost"): sbc_set.total_cost = sbc_info["total_cost"]
    else:
        sbc_set = SBCSet(
            futgg_id=futgg_id,
            name=sbc_info.get("name", futgg_id),
            category="players", 
            image_url=sbc_info.get("image_url"),
            total_cost=sbc_info.get("total_cost"),
            source="fut.gg",
            scraped_at=datetime.now(UTC),
        )
        session.add(sbc_set)

    await session.flush()

    try:
        # Acessar página de detalhes com retry
        for attempt in range(2):
            try:
                await page.goto(url, wait_until="domcontentloaded", timeout=15000)
                await page.wait_for_timeout(1000)
                break
            except Exception:
                if attempt == 1: raise
                await asyncio.sleep(2)

        details = await _extract_sbc_details(page)

        if details:
            if details.get("description"): sbc_set.description = details["description"]
            if details.get("total_cost"): sbc_set.total_cost = details["total_cost"]
            sbc_set.challenges_count = details.get("challenges_count", 0)
            if details.get("image_url"): sbc_set.image_url = details["image_url"]
            sbc_set.expires_text = details.get("expires_text")
            sbc_set.repeatable_text = details.get("repeatable_text")
            sbc_set.refresh_text = details.get("refresh_text")
            
            if details.get("category"):
                sbc_set.category = details["category"]

            # Limpeza rápida de dependências
            await session.execute(delete(SBCReward).where(SBCReward.sbc_set_id == sbc_set.id))
            await session.execute(delete(SBCChallenge).where(SBCChallenge.sbc_set_id == sbc_set.id))
            await session.execute(delete(PlayerCard).where(PlayerCard.sbc_set_id == sbc_set.id))

            # PlayerCard (Imagem HD)
            if details.get("player_card"):
                pc = details["player_card"]
                session.add(PlayerCard(
                    sbc_set_id=sbc_set.id,
                    name=pc["name"],
                    overall=pc["overall"],
                    position=pc.get("position"),
                    card_image_url=pc.get("card_image_url")
                ))

            # Rewards do Set
            for rw in details.get("rewards", []):
                session.add(SBCReward(
                    sbc_set_id=sbc_set.id,
                    reward_type=rw["reward_type"],
                    name=rw["name"],
                    image_url=rw.get("image_url"),
                    is_untradeable=True
                ))

            # Challenges
            for idx, ch_data in enumerate(details.get("challenges", [])):
                challenge = SBCChallenge(
                    sbc_set_id=sbc_set.id,
                    name=ch_data.get("name", f"Challenge {idx+1}"),
                    estimated_cost=ch_data.get("cost"),
                    formation=ch_data.get("formation"),
                    order_index=idx,
                )
                session.add(challenge)
                await session.flush()

                for rw in ch_data.get("rewards", []):
                    session.add(SBCReward(
                        challenge_id=challenge.id,
                        reward_type="pack",
                        name=rw["name"],
                        image_url=rw.get("image_url"),
                        is_untradeable=True
                    ))

                for req_raw in ch_data.get("requirements", []):
                    parsed = parse_requirement_text(req_raw.get("raw", ""))
                    if parsed:
                        session.add(ChallengeRequirement(
                            challenge_id=challenge.id,
                            requirement_type=parsed.get("requirement_type", "unknown"),
                            operator=parsed.get("operator", "min"),
                            value=str(parsed.get("value", "")),
                            detail=parsed.get("detail"),
                        ))

        await session.flush()
    except Exception as e:
        logger.error(f"Erro ao processar detalhes do SBC {futgg_id}: {e}")


async def _extract_sbc_details(page) -> dict:
    """
    Extração robusta de detalhes via JS injection.
    """
    return await page.evaluate("""
        () => {
            const res = {
                description: document.querySelector('p.text-gray-400')?.textContent?.trim(),
                total_cost: null,
                challenges_count: 0,
                image_url: null,
                category: location.href.includes('/players/') ? 'players' : 
                          location.href.includes('/upgrades/') ? 'upgrades' : 'challenges',
                expires_text: null,
                repeatable_text: null,
                refresh_text: null,
                rewards: [],
                player_card: null,
                challenges: []
            };

            // Custo Total
            const costEl = document.evaluate("//span[contains(text(), 'Total Cost')]/following-sibling::span", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
            if (costEl) res.total_cost = parseInt(costEl.textContent.replace(/[^\\d]/g, ''));

            // Metadados (Status Grid)
            document.querySelectorAll('.bg-gray-900.rounded.flex').forEach(el => {
                const label = el.querySelector('span:first-child')?.textContent?.trim();
                const value = el.querySelector('span:last-child')?.textContent?.trim();
                if (label?.includes('Expires')) res.expires_text = value;
                if (label?.includes('Repeatable')) res.repeatable_text = value;
                if (label?.includes('Refreshes')) res.refresh_text = value;
                if (label?.includes('Challenges')) res.challenges_count = parseInt(value) || 0;
            });

            // Imagem HD (Prioridade para o Card)
            const mainImg = document.querySelector('.fc-card img, img[src*="/sbcs/"]');
            if (mainImg) res.image_url = mainImg.src.split('?')[0];

            // Recompensas Globais
            document.querySelectorAll('img[src*="/public-assets/pack.webp"]').forEach(img => {
                const container = img.closest('div');
                const name = container?.textContent?.trim() || 'Pack';
                res.rewards.push({
                    name: name,
                    reward_type: 'pack',
                    image_url: img.src
                });
            });

            // Player Card Detalhes
            const cardImg = document.querySelector('.fc-card img');
            if (cardImg) {
                const cardContainer = cardImg.closest('.fc-card');
                res.player_card = {
                    name: document.querySelector('h1')?.textContent?.trim() || 'Player',
                    overall: parseInt(cardContainer?.querySelector('.font-numbers-bold')?.textContent) || 0,
                    position: cardContainer?.querySelector('.bg-orange span')?.textContent?.trim(),
                    card_image_url: cardImg.src.split('?')[0]
                };
            }

            // Challenges
            document.querySelectorAll('.bg-gray-800.rounded-lg').forEach(chEl => {
                const title = chEl.querySelector('h3, h4')?.textContent?.trim();
                if (!title || title === res.player_card?.name) return;

                const reqs = [];
                chEl.querySelectorAll('li').forEach(li => reqs.push({ raw: li.textContent.trim() }));
                
                const cost = chEl.querySelector('.text-sm.font-bold')?.textContent?.replace(/[^\\d]/g, '');
                
                const rwImg = chEl.querySelector('img[src*="pack.webp"]');
                const rwName = rwImg?.closest('div')?.textContent?.trim() || 'Reward';

                res.challenges.push({
                    name: title,
                    cost: cost ? parseInt(cost) : null,
                    requirements: reqs,
                    rewards: rwImg ? [{ name: rwName, image_url: rwImg.src }] : []
                });
            });

            return res;
        }
    """)


        # Pós-processar requisitos
        if details and details.get("challenges"):
            for ch in details["challenges"]:
                parsed_reqs = []
                for raw_req in ch.get("requirements", []):
                    parsed = parse_requirement_text(raw_req.get("raw", ""))
                    if parsed:
                        parsed_reqs.append(parsed)
                ch["requirements"] = parsed_reqs

        return details or {}

    except Exception:
        return {}
